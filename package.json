{
  "name": "balance-ton-flic",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build:masque": "npm run build --prefix vendor/masque",
    "generate:shares": "node scripts/generate-share-pages.mjs",
    "prestart": "npm run generate:shares",
    "start": "ng serve",
    "prebuild": "npm run generate:shares",
    "build": "ng build",
    "postbuild": "node scripts/generate-route-entries.mjs",
    "prebuild:pages": "npm run generate:shares",
    "build:pages": "ng build --base-href /BalanceTonFlic/",
    "postbuild:pages": "node scripts/generate-route-entries.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
